{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Where in the World Are Terry and Dana</title>\n<meta name=\"description\" content=\"Digital nomads on the move. See where Terry and Dana are right now, everywhere they have been since selling the house, and where they are headed next.\">\n<link rel=\"canonical\" href=\"https://www.whereintheworldareterryanddana.com/\">\n<meta name=\"theme-color\" content=\"#0B1233\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:url\" content=\"https://www.whereintheworldareterryanddana.com/\">\n<meta property=\"og:title\" content=\"Where in the world are Terry and Dana?\">\n<meta property=\"og:description\" content=\"Digital nomads on the move. See where we are right now, replay the whole trip, and find out where we are headed next.\">\n<meta property=\"og:image\" content=\"https://www.whereintheworldareterryanddana.com/preview/og.jpg\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"icon\" href=\"/favicon.ico\">\n<script>\n/* Ask for the travel sheet and the photo list straight away, while the rest of the page loads. */\n(function () {\n  function get(url, ms) {\n    var stop = window.AbortController ? new AbortController() : null;\n    var timer = setTimeout(function () { if (stop) stop.abort(); }, ms);\n    return fetch(url, { cache: 'no-store', signal: stop ? stop.signal : undefined })\n      .then(function (r) { if (!r.ok) throw new Error(url + ' ' + r.status); return r.json(); })\n      .then(function (value) { clearTimeout(timer); return { ok: true, value: value }; }, function (error) { clearTimeout(timer); return { ok: false, error: String(error) }; });\n  }\n  window.__early = { get: get, travel: get('/api/travel-data', 20000), photos: get('/api/photos', 45000) };\n  /* If the page's own code cannot start (a very old browser, a broken download), say so on the sign instead of leaving it blank. */\n  window.__fail = function () {\n    if (window.__trip) return;\n    var place = document.getElementById('place'), region = document.getElementById('region');\n    if (!place || !region) return;\n    document.documentElement.className += ' failed';\n    document.getElementById('tab').textContent = 'Sorry';\n    place.className = 'place long'; place.textContent = 'Something went wrong';\n    region.innerHTML = 'Please reload, or use <a href=\"/previous\">the previous site</a> for now.';\n  };\n  /* Only this page's own code counts: browsers, apps and extensions add scripts that can raise errors of their own. */\n  window.addEventListener('error', function (event) { if (!window.__trip && /\\/app\\.js/.test(String(event.filename || ''))) window.__fail(); });\n  setTimeout(function () { window.__fail(); }, 12000);\n})();\n</script>\n<link rel=\"preload\" href=\"/preview/fonts/overpass.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n<link rel=\"preload\" href=\"/preview/earth/day-1k.webp\" as=\"fetch\" crossorigin fetchpriority=\"low\">\n<link rel=\"modulepreload\" href=\"/preview/app.js\">\n<style>\n/* A roadside scene. The opener is the sky where we are right now, with a neon-script wordmark, a highway guide sign that\n   answers the site's question, and the Earth as the stage: real satellite imagery, lit by where the sun really is.\n   One time slider drives it all. Below: postcards, a marigold band of numbers, then the plan and the log on a calm page. */\n@font-face{font-family:\"Overpass\";src:url(/preview/fonts/overpass.woff2) format(\"woff2\");font-weight:100 900;font-style:normal;font-display:swap}\n/* The wordmark and the sign-off are the only script lettering, so the few letters they use travel inside the page:\n   the neon sign is lit from the first paint. Any other letter would be fetched from the full face on demand. */\n@font-face{font-family:\"Yellowtail Mark\";src:url(data:font/woff2;base64,) format(\"woff2\");font-weight:400;font-style:normal;unicode-range:U+20,U+26,U+2E,U+44,U+53,U+54,U+61,U+64,U+65,U+68,U+6E,U+6F,U+72,U+74,U+75,U+77,U+79}\n@font-face{font-family:\"Yellowtail\";src:url(/preview/fonts/yellowtail.woff2) format(\"woff2\");font-weight:400;font-style:normal;font-display:block}\n@font-face{font-family:\"Caveat\";src:url(/preview/fonts/caveat.woff2) format(\"woff2\");font-weight:500 700;font-style:normal;font-display:block}\n/* Stand-ins the same width as the two script faces, so nothing moves when the real ones arrive. */\n@font-face{font-family:\"Yellowtail Fallback\";src:local(\"Arial\"),local(\"Helvetica\"),local(\"Roboto\"),local(\"Liberation Sans\"),local(\"DejaVu Sans\");size-adjust:83%}\n@font-face{font-family:\"Caveat Fallback\";src:local(\"Arial\"),local(\"Helvetica\"),local(\"Roboto\"),local(\"Liberation Sans\"),local(\"DejaVu Sans\");size-adjust:76%}\n:root{\n  --bg:#F3F6FB; --surface:#FFFFFF; --ink:#14213D; --muted:#4D5A73; --line:#D3DCE8; --accent:#B4284A; --focus:#14213D; --thumb:#77839B;\n  --sign:#0A6A4D; --sign-ink:#FFFFFF; --stripe:#F6B817; --stripe-ink:#231C00;\n  /* the sky, the band and the footer are scenes of their own and look the same in both themes */\n  --sky-ink:#FFFFFF; --sky-soft:#DCE8F8; --glass:rgba(6,12,34,.52); --glass-line:rgba(255,255,255,.28); --neon:#FFF3D2;\n  --band:#F6B817; --band-ink:#14213D; --night:#0A1130; --night-ink:#F4F1E6;\n  --paper:#FCFCF9; --paper-ink:#1B2226;\n  --display:\"Overpass\",\"Helvetica Neue\",Arial,sans-serif;\n  --hand:\"Caveat\",\"Caveat Fallback\",\"Segoe Script\",\"Bradley Hand\",cursive;\n  --script:\"Yellowtail Mark\",\"Yellowtail\",\"Yellowtail Fallback\",\"Brush Script MT\",\"Segoe Script\",cursive;\n  --gutter:clamp(16px,4vw,48px);\n}\n@media (prefers-color-scheme: dark){\n  :root:not([data-theme=\"light\"]){\n    --bg:#0B1226; --surface:#141E3C; --ink:#EDF1F8; --muted:#A3AFC8; --line:#27345A; --accent:#FF8FA1; --focus:#F8C22E; --thumb:#66749C; color-scheme:dark;\n  }\n}\n:root[data-theme=\"dark\"]{\n  --bg:#0B1226; --surface:#141E3C; --ink:#EDF1F8; --muted:#A3AFC8; --line:#27345A; --accent:#FF8FA1; --focus:#F8C22E; --thumb:#66749C; color-scheme:dark;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%;scroll-behavior:smooth}\nhtml.viewing{overflow:hidden}\nbody{margin:0;background:var(--bg);color:var(--ink);font-family:var(--display);font-size:16px;line-height:1.45}\nimg{max-width:100%}\n[hidden]{display:none!important}\nhtml.failed .transport,html.failed .toolrow,html.failed .dayline,html.failed .top nav,html.failed main > section{display:none}\nbutton{font:inherit;color:inherit;cursor:pointer}\nbutton:disabled{cursor:default;opacity:.45}\na{color:inherit}\n:focus-visible{outline:3px solid var(--focus);outline-offset:2px;border-radius:4px}\nh2{font-size:clamp(1.7rem,2.8vw,2.3rem);font-weight:900;letter-spacing:-.015em;line-height:1.1;margin:0;text-wrap:balance}\n.wrap{max-width:1336px;margin-inline:auto;padding-inline:var(--gutter);padding-left:max(var(--gutter),env(safe-area-inset-left));padding-right:max(var(--gutter),env(safe-area-inset-right))}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n\n/* ---------- the sky ---------- */\n.sky{--focus:#FFD45C;position:relative;color:var(--sky-ink);padding-block:0 30px;overflow:hidden;\n  background:radial-gradient(60% 50% at 92% -6%,rgba(255,220,140,.28),rgba(255,220,140,0) 70%),linear-gradient(180deg,#072A66 0%,#0E4E97 56%,#1A66AE 100%)}\n.sky[data-sky=\"dawn\"]{background:linear-gradient(180deg,#0F1A4B 0%,#35377F 40%,#A65585 76%,#D9825A 100%)}\n.sky[data-sky=\"dusk\"]{background:linear-gradient(180deg,#17133F 0%,#4A2470 38%,#A8386E 74%,#D5653B 100%)}\n.sky[data-sky=\"night\"]{background:radial-gradient(60% 45% at 80% 100%,rgba(92,72,170,.32),rgba(92,72,170,0) 70%),linear-gradient(180deg,#04071A 0%,#0B1233 55%,#1C1A4D 100%)}\n#stars{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:0;transition:opacity 1.2s}\n.sky[data-sky=\"dusk\"] #stars,.sky[data-sky=\"dawn\"] #stars{opacity:.5}\n.sky[data-sky=\"night\"] #stars{opacity:1}\n.sky .wrap{position:relative}\n\n.top{display:flex;align-items:center;justify-content:space-between;gap:8px 16px;flex-wrap:wrap;padding-block:14px 18px}\n.brand{display:flex;align-items:center;gap:10px}\n.mark{font-family:var(--script);font-size:clamp(2.1rem,3.4vw,2.8rem);line-height:1.1;color:var(--neon);text-decoration:none;\n  text-shadow:0 0 2px rgba(255,255,255,.55),0 0 16px rgba(255,186,84,.7),0 0 38px rgba(255,120,90,.45);padding:2px 6px 2px 0}\n.top nav{display:flex;gap:2px 4px;flex-wrap:wrap;align-items:center;margin-left:auto}\n.top nav a{padding:7px 10px;border-radius:6px;font-weight:600;color:var(--sky-ink);text-decoration:none}\n.top nav a:hover{background:rgba(255,255,255,.16)}\n.top .site{padding:7px 12px;border-radius:6px;border:1px solid var(--glass-line);background:var(--glass);font-weight:600;color:var(--sky-ink);text-decoration:none;white-space:nowrap}\n.top .site:hover{border-color:var(--sky-ink)}\n\n.stage{display:grid;grid-template-columns:minmax(300px,410px) minmax(0,1fr);grid-template-areas:\"lead globe\" \"bar bar\";gap:22px 40px;align-items:start;--gh:clamp(430px,64vh,680px)}   /* --gh: how tall the globe's box is */\n.lead{grid-area:lead;display:flex;flex-direction:column;gap:20px;min-width:0}\n.tagline{margin:0;font-weight:900;font-size:clamp(1.9rem,3.1vw,2.75rem);line-height:1.02;letter-spacing:-.02em;text-wrap:balance}\n.blurb{margin:8px 0 0;color:var(--sky-soft);font-size:1.06rem;max-width:32ch}\n.answer{display:flex;flex-direction:column;gap:10px}\n.q{margin:0;font-weight:600;font-size:1.02rem;line-height:1.3}\n\n.sign{position:relative;padding-top:34px}\n.tab{position:absolute;top:0;right:18px;height:38px;display:flex;align-items:center;gap:8px;padding:0 14px 4px;background:var(--sign);color:var(--sign-ink);\n  border:3px solid var(--sign-ink);border-bottom:0;border-radius:10px 10px 0 0;font-weight:800;font-size:.95rem;box-shadow:0 0 0 2px var(--sign);font-variant-numeric:tabular-nums}\n.tab::after{content:\"\";position:absolute;left:0;right:0;bottom:-3px;height:5px;background:var(--sign)}\n.board{position:relative;background:var(--sign);color:var(--sign-ink);border:4px solid var(--sign-ink);border-radius:16px;box-shadow:0 0 0 3px var(--sign),0 18px 34px -16px rgba(0,0,0,.6);\n  padding:16px 22px;height:164px;display:flex;flex-direction:column;justify-content:center;overflow:hidden}\n.place{margin:0;font-weight:800;font-size:clamp(2.3rem,4.4vw,3.5rem);line-height:.98;letter-spacing:-.015em;overflow-wrap:anywhere}\n.place.long{font-size:clamp(1.8rem,3.1vw,2.35rem)}\n.region{margin:8px 0 0;font-weight:600;font-size:1.3rem;line-height:1.15}\n.dayline{margin:2px 0 0;font-weight:800;font-size:1.2rem;color:var(--stripe);font-variant-numeric:tabular-nums}\n\n.detail{display:flex;flex-direction:column;gap:14px;min-height:198px}\n.facts{display:grid;grid-template-columns:max-content max-content minmax(0,1fr);gap:12px 26px;margin:0}\n.facts.two{grid-template-columns:repeat(2,minmax(0,1fr))}\n.facts div{min-width:0}\n.facts .wide{grid-column:1/-1}\n.facts dt{font-size:.85rem;color:var(--sky-soft)}\n.facts dd{margin:1px 0 0;font-weight:600;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}\n.ahead{background:var(--sign);color:var(--sign-ink);border:3px solid var(--sign-ink);border-radius:12px;box-shadow:0 0 0 2px var(--sign),0 14px 26px -16px rgba(0,0,0,.6);padding:5px}\n.ahead p{margin:0;padding:3px 10px 1px;font-size:.84rem;font-weight:600}\n.mile{display:flex;justify-content:space-between;align-items:baseline;gap:16px;width:100%;background:none;border:0;padding:4px 10px;border-radius:6px;font-weight:800;font-size:1.08rem;text-align:left}\n.mile:hover{background:rgba(255,255,255,.16)}\n.mile span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.mile b{font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}\n\n.globe{grid-area:globe;min-width:0;display:flex;flex-direction:column;gap:8px}\n.gbox{position:relative;height:var(--gh);border-radius:8px}\n.gbox canvas{position:absolute;inset:0;width:100%;height:100%;display:block}\n.gbox .earth{pointer-events:none}\n.gbox .lines{touch-action:pan-y;cursor:grab}\n.gbox .lines.drag{cursor:grabbing}\n.gbox .lines.hit{cursor:pointer}\n.pulse{position:absolute;left:0;top:0;width:0;height:0;pointer-events:none}\n.pulse::before{content:\"\";position:absolute;left:-8px;top:-8px;width:16px;height:16px;border-radius:50%;border:2px solid var(--stripe);animation:ping 1.9s ease-out infinite}\n@keyframes ping{from{transform:scale(.9);opacity:.95}to{transform:scale(3.6);opacity:0}}\n.gctl{display:flex;gap:6px}\n.gl{background:var(--glass);color:var(--sky-ink);border:1px solid var(--glass-line);border-radius:6px;padding:6px 11px;font-weight:600;min-height:38px;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}\n.gl:hover:not(:disabled){border-color:var(--sky-ink)}\n.gctl .gl{width:40px;height:40px;padding:0;display:grid;place-items:center;font-size:1.25rem;line-height:1}\n.gctl svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.6}\n.toolrow{display:flex;justify-content:flex-end;align-items:center;gap:10px;flex-wrap:wrap;min-height:34px}\n.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:.85rem;margin:0;padding:5px 12px;list-style:none;background:var(--glass);border-radius:99px}\n.legend li{display:flex;align-items:center;gap:6px}\n.legend svg{width:28px;height:8px;overflow:visible}\n.tip{position:absolute;left:0;top:0;pointer-events:none;background:var(--paper);color:var(--paper-ink);padding:6px 10px;border-radius:6px;font-size:.85rem;font-weight:800;transform:translate(-50%,-135%);white-space:nowrap;box-shadow:0 6px 16px -6px rgba(0,0,0,.6);z-index:3}\n.tip span{display:block;font-weight:400}\n\n.card{position:relative;grid-area:globe;align-self:end;justify-self:start;z-index:2;width:clamp(176px,17vw,236px);margin:0 0 50px 2px}\n.reelctl{position:absolute;top:15px;right:15px;width:28px;height:28px;padding:0;border:0;border-radius:50%;display:grid;place-items:center;background:rgba(0,0,0,.58);color:#fff}\n.reelctl:hover{background:rgba(0,0,0,.8)}\n.reelctl svg{width:11px;height:11px;fill:currentColor}\n.polaroid{position:relative;display:block;width:100%;background:var(--paper);color:var(--paper-ink);padding:9px 9px 10px;border:0;border-radius:3px;text-align:left;cursor:zoom-in;\n  box-shadow:0 1px 2px rgba(0,0,0,.3),0 20px 34px -14px rgba(0,0,0,.7);transform:rotate(-2.2deg);transition:transform .18s}\n.polaroid:hover{transform:rotate(-1deg) scale(1.02)}\n.polaroid .ph{position:relative;display:block;aspect-ratio:4/3;background:#D9DDD6;overflow:hidden}\n.polaroid .ph.tall{aspect-ratio:4/5}\n.polaroid img{width:100%;height:100%;object-fit:cover;display:block}\n.polaroid img.over{position:absolute;inset:0;opacity:0;transition:opacity .6s}\n.polaroid.narrow{width:82%}\n.polaroid .hand{display:block;margin-top:7px;font-family:var(--hand);font-size:1.45rem;font-weight:600;line-height:1.05}\n.polaroid .count{position:absolute;right:6px;bottom:6px;background:rgba(0,0,0,.62);color:#fff;font-size:.76rem;font-weight:800;padding:2px 8px;border-radius:99px}\n.polaroid.words{cursor:default;padding:14px 14px 12px}\n.polaroid.words .hand{margin:0;font-size:1.55rem}\n\n.transport{grid-area:bar;display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px 18px;align-items:center;padding:14px 16px;background:var(--glass);border:1px solid var(--glass-line);border-radius:12px;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}\n.btns{display:flex;gap:6px;align-items:center}\n.play{background:var(--stripe);color:var(--stripe-ink);border:0;border-radius:6px;font-weight:800;padding:8px 16px;min-height:42px;min-width:186px;box-shadow:0 0 22px -4px rgba(246,184,23,.75)}\n.play:hover{filter:brightness(1.08)}\n.step{background:none;border:1px solid var(--glass-line);border-radius:6px;width:42px;height:42px;padding:0;display:grid;place-items:center}\n.step:hover:not(:disabled){border-color:var(--sky-ink)}\n.step svg{width:16px;height:16px;fill:currentColor}\n.scrub{position:relative;min-width:0;padding-bottom:22px}\n.track{position:absolute;left:0;right:0;top:11px;height:6px;border-radius:3px;background:rgba(255,255,255,.24);overflow:hidden}\n.track i{position:absolute;top:0;bottom:0;display:block}\n.track .plan{right:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,.8) 0 6px,transparent 6px 11px);opacity:.6}\n.track .done{left:0;background:var(--stripe)}\n.scrub input{position:relative;display:block;width:100%;height:28px;margin:0;background:transparent;-webkit-appearance:none;appearance:none;cursor:pointer}\n.scrub input::-webkit-slider-runnable-track{background:transparent;height:28px}\n.scrub input::-moz-range-track{background:transparent;height:28px}\n.scrub input::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;margin-top:3px;border-radius:50%;background:var(--sky-ink);border:3px solid var(--night);box-shadow:0 0 0 2px var(--sky-ink)}\n.scrub input::-moz-range-thumb{width:16px;height:16px;border-radius:50%;background:var(--sky-ink);border:3px solid var(--night);box-shadow:0 0 0 2px var(--sky-ink)}\n.ticks{position:absolute;left:11px;right:11px;bottom:0;height:20px;font-size:.8rem;color:var(--sky-soft);font-variant-numeric:tabular-nums}\n.ticks span{position:absolute;top:0;transform:translateX(-50%);white-space:nowrap}\n.ticks span::before{content:\"\";position:absolute;left:50%;top:-7px;width:1px;height:6px;background:var(--sky-soft)}\n.ticks .today{color:var(--stripe);font-weight:800}\n.right{display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end}\n.when{font-weight:800;font-variant-numeric:tabular-nums;min-width:8.6ch;text-align:right}\n\n/* ---------- postcards ---------- */\n.block{padding-block:60px 0}\n.block p.sub{margin:8px 0 0;color:var(--muted);max-width:62ch}\n.block p.sub a{color:var(--ink);font-weight:600}\n.striphead{display:flex;align-items:flex-end;justify-content:space-between;gap:12px 24px}\n.striphead > div:first-child{min-width:0}\n.stripnav{display:flex;gap:6px;flex:none}\n.stripnav button{width:42px;height:42px;padding:0;display:grid;place-items:center;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:50%}\n.stripnav button:hover:not([aria-disabled=\"true\"]){border-color:var(--ink)}\n.stripnav button[aria-disabled=\"true\"]{opacity:.4;cursor:default}\n.stripnav svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.4}\n@media (hover:none) and (pointer:coarse){.stripnav{display:none}}       /* a finger swipes the row; the arrows are for a mouse */\n.strip{display:flex;gap:22px;overflow-x:auto;padding:26px 10px 30px;margin-inline:-10px;scroll-snap-type:x proximity}\n.strip::-webkit-scrollbar{height:10px}\n.strip::-webkit-scrollbar-track{background:transparent}\n.strip::-webkit-scrollbar-thumb{background:var(--thumb);border-radius:99px;border:2px solid var(--bg)}\n.strip::-webkit-scrollbar-thumb:hover{background:var(--muted)}\n@supports not selector(::-webkit-scrollbar){.strip{scrollbar-width:thin;scrollbar-color:var(--thumb) transparent}}\n.pc{position:relative;flex:0 0 auto;width:190px;background:var(--paper);color:var(--paper-ink);border:0;border-radius:3px;padding:9px 9px 10px;text-align:left;scroll-snap-align:center;cursor:zoom-in;\n  box-shadow:0 1px 2px rgba(10,17,48,.25),0 14px 24px -14px rgba(10,17,48,.55);transform:rotate(-2deg);transition:transform .18s}\n.pc:nth-child(2n){transform:rotate(1.6deg) translateY(6px)}\n.pc:nth-child(3n){transform:rotate(-.8deg) translateY(-4px)}\n.pc:hover,.pc:focus-visible{transform:rotate(0) translateY(-6px) scale(1.04)}\n.pc img{display:block;width:100%;aspect-ratio:1/1;object-fit:cover;background:#D9DDD6}\n.pc .hand{display:block;margin-top:7px;font-family:var(--hand);font-size:1.35rem;font-weight:600;line-height:1.05}\n.pc .count{position:absolute;right:15px;top:15px;background:rgba(0,0,0,.62);color:#fff;font-family:var(--display);font-size:.76rem;font-weight:800;padding:2px 8px;border-radius:99px}\n\n/* ---------- numbers band ---------- */\n.band{--focus:#14213D;margin-top:56px;background:var(--band);color:var(--band-ink);padding-block:52px 56px}\n.bandgrid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:36px 56px;align-items:start;margin-top:28px}\n.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 32px;margin:0}\n.stats div{min-width:0;border-top:4px solid var(--band-ink);padding-top:10px}\n.stats dt{font-size:.98rem;font-weight:600}\n.stats dd{margin:0;font-weight:900;font-size:clamp(1.7rem,3vw,2.6rem);line-height:1.05;letter-spacing:-.02em;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}\n.stats small{display:block;font-size:.92rem;font-weight:600;letter-spacing:0;margin-top:4px;line-height:1.3}\n.statesfig{margin:0;border-top:4px solid var(--band-ink);padding-top:10px}\n.statesfig h3{margin:0;font-size:.98rem;font-weight:600}\n.statesfig .big{display:block;font-weight:900;font-size:clamp(1.7rem,3vw,2.6rem);line-height:1.05;letter-spacing:-.02em}\n.statesfig svg{display:block;width:100%;height:auto;margin-top:12px}\n.statesfig figcaption{font-size:.92rem;font-weight:600;margin-top:8px;line-height:1.35}\n.st{fill:rgba(20,33,61,.13);stroke:var(--band);stroke-width:1.4}\n.st.been{fill:var(--band-ink)}\n.st.plan{fill:rgba(20,33,61,.13);stroke:var(--band-ink);stroke-width:2;stroke-dasharray:5 4}\n\n/* ---------- plan and log ---------- */\n.rows{list-style:none;margin:24px 0 0;padding:0;border-top:1px solid var(--line)}\n.rows li{border-bottom:1px solid var(--line)}\n.rows button{display:grid;grid-template-columns:minmax(0,15rem) minmax(0,1fr) 6.5rem 8.5rem 44px;gap:6px 20px;align-items:center;width:100%;text-align:left;background:none;border:0;padding:10px 8px;border-radius:4px;min-height:60px}\n.rows button:hover:not(:disabled){background:var(--surface)}\n.rows button:disabled{opacity:1}\n.rows .d{color:var(--muted);font-variant-numeric:tabular-nums}\n.rows .p{font-weight:800;font-size:1.08rem;min-width:0}\n.rows .p small{display:block;font-weight:400;font-size:.88rem;color:var(--muted)}\n.rows .p small.hot{font-weight:800;color:var(--accent)}\n.rows .n{font-variant-numeric:tabular-nums;color:var(--muted)}\n.rows .t{width:44px;height:44px}\n.rows .t img{width:44px;height:44px;object-fit:cover;border-radius:3px;display:block;background:var(--line)}\n.chip{display:inline-block;font-size:.85rem;font-weight:800;padding:2px 10px;border-radius:99px;border:1.5px solid var(--accent);color:var(--accent);white-space:nowrap}\n.chip.booked{background:var(--sign);border-color:var(--sign);color:var(--sign-ink)}\n.chip.pencil{border-style:dashed}\n.chip.someday{border-style:dotted;border-color:var(--muted);color:var(--muted)}\n.chip.base{border-color:var(--line);color:var(--ink);font-weight:600}\n.chip.stop{border-color:transparent;color:var(--muted);padding-left:0;font-weight:600}\n.chip.here{background:var(--stripe);border-color:var(--stripe);color:var(--stripe-ink)}\n.years{display:flex;gap:6px;flex-wrap:wrap;margin-top:20px}\n.pill{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:6px 13px;font-weight:800;min-height:38px}\n.pill:hover{border-color:var(--ink)}\n.pill[aria-pressed=\"true\"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}\n\nfooter{--focus:#FFD45C;margin-top:72px;background:var(--night);color:var(--night-ink);padding-block:44px 52px}\n.bye{margin:0;font-family:var(--script);font-size:clamp(2rem,4vw,3rem);line-height:1.15;color:var(--neon);text-shadow:0 0 2px rgba(255,255,255,.55),0 0 16px rgba(255,186,84,.7),0 0 38px rgba(255,120,90,.45)}\n.links{display:flex;gap:6px 22px;flex-wrap:wrap;margin:18px 0 0;padding:0;list-style:none;font-weight:600}\n.links a{display:inline-block;padding-block:4px;text-underline-offset:3px}\n.fine{margin:16px 0 0;font-size:.9rem;color:#C9CFE0;max-width:74ch}\n\n/* ---------- photo viewer ---------- */\ndialog:not([open]){display:none}\ndialog.viewer{--focus:#FFD45C;border:0;padding:0;margin:0;background:rgba(5,9,26,.95);color:#fff;width:100vw;height:100vh;height:100dvh;max-width:none;max-height:none;overflow:hidden}\ndialog.viewer::backdrop{background:rgba(5,9,26,.6)}\n.vwrap{position:absolute;inset:0;display:grid;grid-template-rows:minmax(0,1fr) auto;justify-items:center;gap:12px;padding:18px 14px 14px;pointer-events:none}\n.vwrap > *{pointer-events:auto}\n.vfig{margin:0;min-height:0;display:grid;grid-template-rows:minmax(0,1fr) auto;justify-items:center;gap:10px;align-self:stretch;pointer-events:none}\n.vfig > *{pointer-events:auto}\n.vimg{display:block;max-width:100%;max-height:100%;min-height:0;object-fit:contain;align-self:center;border-radius:3px;background:#0E1430;box-shadow:0 30px 60px -20px rgba(0,0,0,.8);touch-action:pan-y pinch-zoom}\n.vfig figcaption{text-align:center;max-width:60ch}\n.vhand{display:block;font-family:var(--hand);font-size:1.9rem;font-weight:600;line-height:1.05}\n.vcap{display:block;margin-top:4px;color:#D5DBEA}\n.vbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center}\n.vbar button{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.3);color:#fff;border-radius:6px;padding:8px 14px;font-weight:600;min-height:42px}\n.vbar button:hover{border-color:#fff}\n.vbar .vprev,.vbar .vnext{width:46px;padding:0;display:grid;place-items:center}\n.vbar svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.4}\n.vcount{min-width:7ch;text-align:center;font-weight:800;font-variant-numeric:tabular-nums}\n.vbar .vclose{background:var(--stripe);border-color:var(--stripe);color:var(--stripe-ink);font-weight:800}\n\n@media (max-width:860px){\n  .stage{grid-template-columns:minmax(0,1fr);grid-template-areas:\"hello\" \"answer\" \"globe\" \"bar\" \"detail\";gap:18px;--gh:min(92vw,520px)}\n  .lead{display:contents}\n  .hello{grid-area:hello}.answer{grid-area:answer}.detail{grid-area:detail;min-height:176px}\n  .facts{background:var(--glass);border:1px solid var(--glass-line);border-radius:12px;padding:10px 14px}\n  .blurb{max-width:none}\n  .board{height:auto;min-height:128px}\n  .toolrow{justify-content:space-between;flex-wrap:nowrap;gap:6px}\n  .legend{gap:9px;font-size:.78rem;padding:0;background:none;flex-wrap:nowrap}\n  .legend li{gap:4px}\n  .legend svg{width:18px}\n  .gctl .gl{width:38px;height:38px}\n  .card{width:128px;margin:0 0 54px 0}\n  .reelctl{top:9px;right:9px;width:24px;height:24px}\n  .reelctl svg{width:9px;height:9px}\n  .polaroid{padding:6px 6px 7px}\n  .polaroid .hand{font-size:1.08rem;margin-top:4px}\n  .polaroid .count{font-size:.7rem;padding:1px 6px}\n  .polaroid.words{padding:10px 10px 9px}\n  .polaroid.words .hand{font-size:1.15rem;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:6;overflow:hidden}\n  .transport{grid-template-columns:minmax(0,1fr)}\n  .btns .play{flex:1}\n  .right{justify-content:space-between}\n  .bandgrid{grid-template-columns:minmax(0,1fr)}\n  .rows button{grid-template-columns:minmax(0,1fr) auto auto;grid-template-areas:\"d n t\" \"p c t\";gap:2px 12px;align-items:start;padding:10px 4px}\n  .rows .d{grid-area:d}.rows .p{grid-area:p}.rows .n{grid-area:n;text-align:right}.rows .c{grid-area:c;justify-self:end}\n  .rows .t{grid-area:t;align-self:center}\n  .rows .t:empty{display:none}\n  .top{padding-block:12px 12px;gap:4px 10px}\n  .top .site{margin-left:auto;padding:5px 10px;font-size:.9rem}\n  .top nav{order:3;flex-basis:100%;margin-left:-8px;flex-wrap:nowrap;justify-content:space-between}\n  .top nav a{padding:6px 8px;font-size:.92rem;white-space:nowrap}\n  .pc{width:160px}\n}\n@media (max-width:420px){\n  .stats{gap:22px 18px}\n  .top nav{margin-left:-5px}\n  .top nav a{padding:6px 5px;font-size:.86rem}\n}\n@media (max-width:384px){\n  .mark{font-size:1.85rem}\n  .brand{gap:6px}\n  .top{gap:4px 6px}\n  .top .site{padding:5px 8px;font-size:.84rem}\n}\n@media (max-width:350px){\n  .top nav{flex-wrap:wrap;justify-content:flex-start}\n}\n/* Where the globe's column is not much wider than the globe is tall, there is no room beside the globe for the photo.\n   There the photo hangs below the globe, next to the map key and the zoom buttons, and the globe stays clear.\n   (--box: the globe's box, never taller than its column is wide. globe.js reads --photo.) */\n@media (max-width:600px),(min-width:861px) and (max-width:1180px),(min-width:1181px) and (max-width:1259px) and (min-height:841px),(min-width:1260px) and (max-width:1335px) and (min-height:941px){\n  .stage{position:relative;--card:clamp(132px,14.5vw,168px);--ledge:88px;--box:min(var(--gh),min(100vw,1336px) - 2*var(--gutter) - 450px)}\n  .gbox{--photo:below;height:var(--box)}\n  .toolrow{flex-direction:column-reverse;flex-wrap:nowrap;justify-content:flex-end;align-items:flex-end;gap:8px;min-height:var(--ledge);padding-left:calc(var(--card) + 10px)}\n  .legend{justify-content:flex-end;padding:4px 11px;border-radius:14px}\n  .card{position:absolute;left:0;top:calc(var(--box) + 8px + var(--ledge));transform:translateY(-100%);width:var(--card);margin:0}\n  .polaroid .ph.tall{aspect-ratio:1/1}\n  .polaroid .hand{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;font-size:1.25rem}\n  .polaroid.words .hand{font-size:1.3rem;-webkit-line-clamp:6}\n}\n@media (min-width:861px) and (max-width:999px){\n  .stage{--ledge:112px}      /* the map key takes two lines beside the photo here */\n}\n@media (max-width:600px){\n  .stage{--card:clamp(116px,34.5vw,136px);--ledge:90px;--box:var(--gh)}\n  .legend{flex-wrap:wrap;gap:3px 8px;padding:0}\n  .legend svg{width:16px}\n  .polaroid .hand{font-size:1.08rem}\n  .polaroid.words .hand{font-size:1.15rem}\n}\n/* short laptop screens: tighten the opener so the replay bar stays in view */\n@media (min-width:861px) and (max-height:800px){\n  .top{padding-block:8px 8px}\n  .stage{gap:14px 40px;--gh:clamp(390px,62vh,500px)}\n  .lead{gap:12px}\n  .tagline{font-size:clamp(1.7rem,2.5vw,2rem)}\n  .blurb{font-size:1rem;margin-top:5px}\n  .answer{gap:7px}\n  .sign{padding-top:30px}\n  .tab{height:34px;font-size:.9rem}\n  .board{height:126px;padding:12px 20px}\n  .place{font-size:clamp(2rem,3.5vw,2.7rem)}\n  .place.long{font-size:clamp(1.6rem,2.6vw,2rem)}\n  .region{font-size:1.15rem;margin-top:6px}\n  .dayline{font-size:1.1rem;margin:0}\n  .detail{gap:10px;min-height:166px}\n  .mile{padding:2px 10px}\n  .transport{padding:10px 14px}\n  .sky{padding-bottom:20px}\n}\n@media (prefers-reduced-motion:reduce){\n  html{scroll-behavior:auto}\n  *{transition:none!important}\n  .pulse::before{animation:none;transform:scale(1.9);opacity:.8}\n}\n</style>\n</head>\n<body>\n<main>\n  <div class=\"sky\" id=\"sky\" data-sky=\"day\">\n    <canvas id=\"stars\" aria-hidden=\"true\"></canvas>\n    <div class=\"wrap\">\n      <header class=\"top\">\n        <div class=\"brand\">\n          <a class=\"mark\" href=\"#stage\">Terry &amp; Dana</a>\n        </div>\n        <nav aria-label=\"Sections\">\n          <a href=\"#postcards\">Postcards</a>\n          <a href=\"#numbers\">The numbers</a>\n          <a href=\"#plan\">What's next</a>\n          <a href=\"#log\">Every stop</a>\n        </nav>\n        <a class=\"site\" href=\"/previous\">Previous site</a>\n      </header>\n\n      <section class=\"stage\" id=\"stage\" aria-label=\"Where we are\">\n        <div class=\"lead\">\n          <div class=\"hello\">\n            <p class=\"tagline\">Digital nomads on the move</p>\n            <p class=\"blurb\">Following our wanderlust around the globe, one city at a time.</p>\n          </div>\n          <div class=\"answer\">\n            <h1 class=\"q\" id=\"q\">Where in the world are Terry and Dana?</h1>\n            <div class=\"sign\">\n              <div class=\"tab\" id=\"tab\">Right now</div>\n              <div class=\"board\" id=\"board\" tabindex=\"-1\" aria-live=\"polite\" aria-atomic=\"true\">\n                <p class=\"place\" id=\"place\">&nbsp;</p>\n                <p class=\"region\" id=\"region\">&nbsp;</p>\n              </div>\n            </div>\n            <p class=\"dayline\" id=\"dayline\">&nbsp;</p>\n          </div>\n          <div class=\"detail\">\n            <dl class=\"facts\" id=\"facts\"></dl>\n            <div class=\"ahead\" id=\"ahead\" hidden></div>\n          </div>\n        </div>\n\n        <div class=\"globe\">\n          <div class=\"gbox\" id=\"globe\" tabindex=\"0\" role=\"group\" aria-label=\"Globe of everywhere we have stayed\" aria-describedby=\"globehelp\">\n            <canvas class=\"earth\" aria-hidden=\"true\"></canvas>\n            <canvas class=\"lines\" role=\"img\" aria-label=\"The Earth, with our route drawn on it and a marker where we are\"></canvas>\n            <div class=\"pulse\" hidden></div>\n            <div class=\"tip\" id=\"tip\" hidden></div>\n            <p class=\"sr\" id=\"globehelp\">Drag to turn the globe, scroll or pinch to zoom, and pick a dot to see that stop. With the keyboard: arrow keys turn it, plus and minus zoom, zero shows the whole globe. Every stop is also listed further down the page.</p>\n          </div>\n          <div class=\"toolrow\">\n            <ul class=\"legend\" aria-label=\"Map key\">\n              <li><svg viewBox=\"0 0 28 8\" aria-hidden=\"true\"><line x1=\"0\" y1=\"4\" x2=\"28\" y2=\"4\" stroke=\"#F6B817\" stroke-width=\"3\" fill=\"none\"/></svg>Driven</li>\n              <li><svg viewBox=\"0 0 28 8\" aria-hidden=\"true\"><path d=\"M0 7 Q14 -4 28 7\" stroke=\"currentColor\" stroke-width=\"1.8\" fill=\"none\"/></svg>Flown</li>\n              <li><svg viewBox=\"0 0 28 8\" aria-hidden=\"true\"><line x1=\"0\" y1=\"4\" x2=\"28\" y2=\"4\" stroke=\"#F6B817\" stroke-width=\"2\" stroke-dasharray=\"5 4\" fill=\"none\"/></svg>Planned</li>\n            </ul>\n            <div class=\"gctl\" id=\"gctl\">\n              <button type=\"button\" class=\"gl\" id=\"zin\" aria-label=\"Zoom in\">+</button>\n              <button type=\"button\" class=\"gl\" id=\"zout\" aria-label=\"Zoom out\">&minus;</button>\n              <button type=\"button\" class=\"gl\" id=\"whole\" aria-label=\"Show the whole globe\" title=\"Show the whole globe\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"8\"/><ellipse cx=\"10\" cy=\"10\" rx=\"3.4\" ry=\"8\"/><line x1=\"2\" y1=\"10\" x2=\"18\" y2=\"10\"/></svg></button>\n            </div>\n          </div>\n        </div>\n        <div class=\"card\" id=\"card\"></div>\n\n        <div class=\"transport\">\n          <div class=\"btns\">\n            <button type=\"button\" class=\"play\" id=\"play\">Replay the whole trip</button>\n            <button type=\"button\" class=\"step\" id=\"prev\" aria-label=\"Previous stop\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 2h2v12H3zM14 2v12L6 8z\"/></svg></button>\n            <button type=\"button\" class=\"step\" id=\"next\" aria-label=\"Next stop\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M11 2h2v12h-2zM2 2v12l8-6z\"/></svg></button>\n          </div>\n          <div class=\"scrub\">\n            <div class=\"track\"><i class=\"plan\" id=\"tplan\"></i><i class=\"done\" id=\"tdone\"></i></div>\n            <input type=\"range\" id=\"scrub\" min=\"0\" max=\"100\" step=\"1\" value=\"0\" aria-label=\"Date\">\n            <div class=\"ticks\" id=\"ticks\" aria-hidden=\"true\"></div>\n          </div>\n          <div class=\"right\">\n            <span class=\"when\" id=\"when\"></span>\n            <button type=\"button\" class=\"gl\" id=\"speed\">Speed 1x</button>\n            <button type=\"button\" class=\"gl\" id=\"today\" hidden>Back to today</button>\n          </div>\n        </div>\n      </section>\n    </div>\n  </div>\n\n  <section class=\"block\" id=\"postcards\">\n    <div class=\"wrap\">\n      <div class=\"striphead\">\n        <div>\n          <h2>Postcards from the road</h2>\n          <p class=\"sub\">Pick one to see it full size. <a href=\"/pictures\">Every photo is in the Picture Book.</a></p>\n        </div>\n        <div class=\"stripnav\" id=\"stripnav\" hidden>\n          <button type=\"button\" id=\"stripprev\" aria-label=\"Earlier postcards\" aria-controls=\"strip\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M10.5 2.5 5 8l5.5 5.5\"/></svg></button>\n          <button type=\"button\" id=\"stripnext\" aria-label=\"More postcards\" aria-controls=\"strip\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M5.5 2.5 11 8l-5.5 5.5\"/></svg></button>\n        </div>\n      </div>\n      <div class=\"strip\" id=\"strip\"></div>\n    </div>\n  </section>\n\n  <section class=\"band\" id=\"numbers\">\n    <div class=\"wrap\">\n      <h2>Since we sold the house</h2>\n      <div class=\"bandgrid\">\n        <dl class=\"stats\" id=\"stats\"></dl>\n        <figure class=\"statesfig\">\n          <h3>States we've stayed in</h3>\n          <span class=\"big\" id=\"statecount\">&nbsp;</span>\n          <svg id=\"states\" viewBox=\"-8 0 990 612\" role=\"img\" aria-labelledby=\"statescap\"></svg>\n          <figcaption id=\"statescap\"></figcaption>\n        </figure>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"block\" id=\"plan\">\n    <div class=\"wrap\">\n      <h2>Where we're headed</h2>\n      <p class=\"sub\">If we're going to be near you, come see us. Pick a stop to find it on the globe.</p>\n      <ul class=\"rows\" id=\"planrows\"></ul>\n    </div>\n  </section>\n\n  <section class=\"block\" id=\"log\">\n    <div class=\"wrap\">\n      <h2>Every stop so far</h2>\n      <div class=\"years\" id=\"years\" role=\"group\" aria-label=\"Year\"></div>\n      <ul class=\"rows\" id=\"logrows\"></ul>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <p class=\"bye\">See you down the road.</p>\n    <ul class=\"links\" id=\"links\">\n      <li><a href=\"/pictures\">Picture Book</a></li>\n      <li><a href=\"/games/index.html\">Retro games</a></li>\n      <li id=\"account\"><a href=\"/auth/signin\">Sign in</a></li>\n      <li><a href=\"/previous\">Previous site</a></li>\n    </ul>\n    <p class=\"fine\" id=\"foot\"></p>\n  </div>\n</footer>\n\n<dialog class=\"viewer\" id=\"viewer\" aria-label=\"Photos\">\n  <div class=\"vwrap\">\n    <figure class=\"vfig\">\n      <img class=\"vimg\" alt=\"\">\n      <figcaption><span class=\"vhand\"></span><span class=\"vcap\"></span></figcaption>\n    </figure>\n    <div class=\"vbar\">\n      <button type=\"button\" class=\"vprev\" aria-label=\"Previous photo\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M10.5 2.5 5 8l5.5 5.5\"/></svg></button>\n      <span class=\"vcount\"></span>\n      <button type=\"button\" class=\"vnext\" aria-label=\"Next photo\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M5.5 2.5 11 8l-5.5 5.5\"/></svg></button>\n      <button type=\"button\" class=\"vgo\">Show on the globe</button>\n      <button type=\"button\" class=\"vclose\">Close</button>\n    </div>\n  </div>\n</dialog>\n\n<noscript><p style=\"padding:16px\">This page needs JavaScript to show where we are.</p></noscript>\n<script type=\"module\" id=\"appjs\" src=\"/preview/app.js\" onerror=\"window.__fail && window.__fail()\"></script>\n<script nomodule>document.getElementById('place').textContent = 'Please update your browser'; document.getElementById('region').textContent = 'This page needs a newer one.';</script>\n</body>\n</html>\n"}
